{
  "name": "codex-worksample",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "draft": "tsc && node dist/draft.js",
    "explain": "tsc && node dist/draft.js --explain",
    "test": "tsc && node --test dist/draft.test.js",
    "grade:a": "node grader/grade.mjs --chart chart-A --expected expected/chart-A.expected.json --draft out/chart-A.draft.json",
    "grade:t": "node grader/grade.mjs --chart chart-T --expected expected/chart-T.expected.json --draft out/chart-T.draft.json",
    "grade:v": "node grader/grade.mjs --chart chart-V --expected expected/chart-V.expected.json --draft out/chart-V.draft.json",
    "check": "tsc && node scripts/check.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.14.0"
  }
}
